<?xml version="1.0" encoding="utf-8"?>
<!-- Rows of the large home-screen widget (finbro_widget.xml). -->
<resources>
    <style name="FinBroWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="FinBroWidgetRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/finbro_widget_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="FinBroWidgetRowValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/finbro_widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
