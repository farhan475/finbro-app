<?xml version="1.0" encoding="utf-8"?>
<!-- Defaults are what the widget shows before the first Dart snapshot arrives
     (and in the widget picker preview); never an amount. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finbro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/finbro_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/finbro_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/finbro_widget_title"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/finbro_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/finbro_widget_balance_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/finbro_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/finbro_widget_loading"
        android:textColor="#5BEB12"
        android:textSize="11sp" />
</LinearLayout>
