<?xml version="1.0" encoding="utf-8"?>
<!-- Styled like the Home "Total Balance" card. Sections appear by widget
     height (FinBroWidgetProvider.tierFor): small = label + update time,
     amount, balance line; medium adds the change line and Income/Expense;
     large adds Available to Spend, the top budget and the next schedule.
     Defaults are what the widget shows before the first Dart snapshot arrives
     (and in the widget picker preview); never an amount. finbro_status
     replaces the chart when no amount may be shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finbro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/finbro_widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/finbro_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/finbro_widget_title"
            android:textColor="@color/finbro_widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/finbro_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/finbro_widget_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/finbro_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/finbro_widget_balance_placeholder"
        android:textColor="@color/finbro_widget_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/finbro_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/finbro_widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/finbro_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:id="@+id/finbro_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="@string/finbro_widget_loading"
            android:textColor="@color/finbro_widget_muted"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Medium and up: Income | Expense (opens Analitik). -->
    <LinearLayout
        android:id="@+id/finbro_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finbro_widget_income"
                android:textColor="@color/finbro_widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/finbro_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/finbro_widget_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finbro_widget_expense"
                android:textColor="@color/finbro_widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/finbro_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/finbro_widget_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Large: Available to Spend (Home), top budget (Budget), next schedule
         (Transaksi Berulang). -->
    <LinearLayout
        android:id="@+id/finbro_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Divider: plain View is not allowed in RemoteViews. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/finbro_widget_border" />

        <LinearLayout
            android:id="@+id/finbro_ats_row"
            style="@style/FinBroWidgetRow">

            <TextView
                style="@style/FinBroWidgetRowLabel"
                android:text="@string/finbro_widget_available" />

            <TextView
                android:id="@+id/finbro_ats"
                style="@style/FinBroWidgetRowValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/finbro_budget_row"
            style="@style/FinBroWidgetRow">

            <TextView
                style="@style/FinBroWidgetRowLabel"
                android:text="@string/finbro_widget_budget" />

            <TextView
                android:id="@+id/finbro_budget"
                style="@style/FinBroWidgetRowValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/finbro_upcoming_row"
            style="@style/FinBroWidgetRow">

            <TextView
                style="@style/FinBroWidgetRowLabel"
                android:text="@string/finbro_widget_upcoming" />

            <TextView
                android:id="@+id/finbro_upcoming"
                style="@style/FinBroWidgetRowValue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
