<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 (minWidth = 70 * 4 - 30, minHeight = 70 * 2 - 30): room for the
     amount and the balance line. updatePeriodMillis (30 min, the platform
     minimum) queues WidgetRefreshWorker so future-dated rows and app-closed
     periods still refresh; while the app runs WidgetSync pushes updates. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/finbro_widget_description"
    android:initialLayout="@layout/finbro_widget"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/finbro_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
